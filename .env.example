# ===== 应用基础 =====
APP_ENV=development
LOG_LEVEL=INFO

# ===== API Key 鉴权（搜索接口）=====
# 空字符串 = 不启用鉴权；非空 = 请求头需携带 x-api-key
SEARCH_API_KEY=

# ===== 管理页面鉴权 =====
# 空字符串 = 不启用鉴权；非空 = 管理页面登录需输入此 key
ADMIN_API_KEY=

# ===== Immich 上游 =====
# 注意：本地 Docker 运行 Immich 时，请确认映射的端口（如 2283 或 3200）
IMMICH_BASE_URL=http://127.0.0.1:2283
IMMICH_API_KEY=your-immich-api-key-here
IMMICH_TIMEOUT_SECONDS=10.0
IMMICH_CONNECT_TIMEOUT_SECONDS=3.0
IMMICH_MAX_RETRIES=2
IMMICH_RETRY_BACKOFF_SECONDS=0.5

# ===== 搜索结果与排序权重 =====
# 视觉识别并发度
SEARCH_MAX_CONCURRENT_VISION=5
# 场景分析并发度
SEARCH_MAX_CONCURRENT_SCENE=10
# 时间权重 α（越新越靠前）
TIME_WEIGHT=0.3
# 相似度权重 β（语义越相关越靠前），与 α 会被自动归一化
SIMILARITY_WEIGHT=0.7
# 时间新鲜度指数衰减半衰期（天）
TIME_DECAY_HALF_LIFE_DAYS=365.0
# EXIF / 文件创建时间均缺失时的回退时间
DEFAULT_DATETIME_ISO=1970-01-01T00:00:00+00:00

# ===== 智能场景分析（多标签体系）=====
SCENE_ENABLED=true
# 进程内 LRU 缓存容量（按 asset_id）
SCENE_CACHE_SIZE=2000
# 第二级零样本推理超时（秒），超时降级返回 primary_scene=None
SCENE_INFER_TIMEOUT_SECONDS=3

# ===== AI 分析（同一个人 vs 相似图片）=====
AI_ANALYZER_PROVIDER=immich
AI_PERSON_CONFIDENCE_THRESHOLD=0.6
AI_SIMILARITY_THRESHOLD=0.75
AI_ANALYZE_TIMEOUT_SECONDS=5.0
AI_ANALYZER_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
AI_MAX_CONCURRENT=10

# ===== 华为云图像识别（预留扩展，默认关闭）=====
HUAWEI_ENABLED=false

# ===== Immich 写回（标签/相册/描述，默认关闭）=====
WRITEBACK_ENABLED=false
# 注意：data/runtime_config.json 中的运行时覆盖优先级高于此配置。
# 如需统一行为，删除 data/runtime_config.json 中的 writeback_enabled 键。

HUAWEI_AK=
HUAWEI_SK=
HUAWEI_PROJECT_ID=
# ===== 华为云人脸识别 FRS（用于人脸分类，默认关闭）=====
HUAWEI_FACE_ENABLED=false
HUAWEI_FRS_ENDPOINT=https://face.cn-north-4.myhuaweicloud.com
# 归为同一人的相似度阈值（0~1）
HUAWEI_FACE_SIMILARITY_THRESHOLD=0.62
# 华为云人脸识别 FRS 人脸库搜索返回的 top_n
HUAWEI_FACE_SEARCH_TOP_N=10
# 人脸检测/入库并发度
HUAWEI_FACE_MAX_CONCURRENT=5
# 临时人脸库名前缀
HUAWEI_FACE_SET_PREFIX=tmp_classify_
# FRS 请求超时（秒）
HUAWEI_FACE_TIMEOUT_SECONDS=15.0
HUAWEI_FACE_CONNECT_TIMEOUT_SECONDS=5.0

# ===== 批量导入（本地文件 → 提取 EXIF → 上传 Immich）=====
IMPORT_MAX_CONCURRENT=3
IMPORT_DEFAULT_DEVICE_ID=batch-import# 允许导入的目录白名单（逗号分隔），生产环境必须配置非空值。
IMPORT_ALLOWED_DIRS=
# 单个文件大小上限（MB）。
IMPORT_MAX_FILE_SIZE_MB=100
# 单次批量导入文件数量上限。
IMPORT_MAX_FILES=1000
# ===== 水印管理（本地图片 → 批量添加文字/图片水印）=====
# 水印功能总开关，关闭后 /api/v1/watermark/apply 返回 503。
WATERMARK_ENABLED=true
# ProcessPoolExecutor 最大子进程数。
WATERMARK_MAX_WORKERS=4
# 单次批量水印处理的文件数量上限。
WATERMARK_MAX_FILES=200
# 单个文件大小上限（MB）。
WATERMARK_MAX_FILE_SIZE_MB=100
# 允许处理源文件的目录白名单（逗号分隔），生产环境必须配置非空值。
WATERMARK_ALLOWED_DIRS=
# 默认水印字体路径（空 = 使用 Pillow 默认字体）。
WATERMARK_DEFAULT_FONT=
# ===== 照片评分系统（持久化到 SQLite/PostgreSQL）=====
# 评分功能总开关，关闭后 /api/v1/ratings 返回 503，搜索结果不附加评分。
RATING_ENABLED=true
# SQLAlchemy 异步数据库 URL。
# SQLite: sqlite+aiosqlite:///./data/ratings.db
# PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/photo_ratings
DATABASE_URL=sqlite+aiosqlite:///./data/ratings.db
# ===== Immich 原生集成（P13-P15 部署）=====
# Immich 版本（docker-compose.override.yml 使用）
IMMICH_VERSION=v3.3.1
# Immich PostgreSQL 密码
IMMICH_DB_PASSWORD=postgres
